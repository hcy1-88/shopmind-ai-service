# Application Settings
APP_NAME=shopmind-ai-service
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=./logs

# Service Configuration
SERVICE_NAME=shopmind-ai-service
SERVICE_PORT=8080
SERVICE_CLUSTER=DEFAULT

# Nacos Configuration
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=shopmind-dev
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=shopmind-ai-service.yaml
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ------------------------- 可选配置 ---------------------

# Milvus Configuration (Fallback - prefer Nacos)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default


# LLM Configuration (Fallback - prefer Nacos)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60
