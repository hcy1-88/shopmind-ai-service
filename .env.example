# Application Settings
APP_NAME=shopmind-ai-service
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Service Configuration
SERVICE_NAME=shopmind-ai-service
SERVICE_PORT=8080
SERVICE_CLUSTER=DEFAULT

# Nacos Configuration
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=shopmind-dev
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=shopmind-ai-service.yaml
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ------------------------- 可选配置 ---------------------
# PostgreSQL Configuration (Fallback - prefer Nacos)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shopmind
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Milvus Configuration (Fallback - prefer Nacos)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default

# RocketMQ Configuration (Fallback - prefer Nacos)
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
ROCKETMQ_GROUP_ID=ai-service-group

# LLM Configuration (Fallback - prefer Nacos)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60
